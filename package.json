{
  "name": "keepessence-core",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "gen": "node scripts/gen-contract.mjs",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "dev": "npm run gen && wrangler d1 migrations apply DB --local && wrangler dev --port 8801 --local-upstream localhost:8801",
    "deploy": "npm run gen && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.12",
    "wrangler": "^4.167.0",
    "yaml": "^2.9.1",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12"
  }
}
